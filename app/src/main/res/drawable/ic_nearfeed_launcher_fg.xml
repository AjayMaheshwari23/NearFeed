<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: the NEAR-FEED mark scaled into the adaptive-icon safe
  zone (central ~66% of 108x108). Black background icon, white mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- radio arcs (upper safe zone) -->
    <path
        android:pathData="M46,54 a8,8 0 1 0 16,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M42,50 a12,12 0 1 0 24,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- abstract N: left node, diagonal, right node -->
    <path
        android:pathData="M34,70 L34,44 L74,70 L74,44"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- peer nodes -->
    <path
        android:pathData="M34,70 m-3.4,0 a3.4,3.4 0 1 0 6.8,0 a3.4,3.4 0 1 0 -6.8,0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M74,70 m-3.4,0 a3.4,3.4 0 1 0 6.8,0 a3.4,3.4 0 1 0 -6.8,0"
        android:fillColor="#FFFFFF" />
</vector>
